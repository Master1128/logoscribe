# Copia este archivo como .env.local y completa lo que vayas a usar.

# Transcripción en la nube (opcionales; sin ellas se usa Whisper local)
OPENAI_API_KEY=
GROQ_API_KEY=

# Organización de párrafos y títulos con Claude (opcional; sin ella se usa el organizador básico)
ANTHROPIC_API_KEY=

# Dónde se guardan audios, base de datos y modelos (por defecto ./data)
# LOGOSCRIBE_DATA_DIR=/ruta/a/datos

# Servidor compatible con OpenAI (LiteLLM, etc.). Vacío = api.openai.com
# OPENAI_BASE_URL=https://llm.ejemplo.com/v1
